      <datasource>dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_jalur' srid=4326 type=MultiLineString checkPrimaryKeyUnicity='1' table="public"."jalur_transportasi" (geom)</datasource>
      <layername>jalur_transportasi</layername>
      <srs>
        <spatialrefsys>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srsid>3452</srsid>
          <srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
          <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
          <geographicflag>true</geographicflag>
        </spatialrefsys>
      </srs>
      <provider encoding="">postgres</provider>
      <renderer-v2 type="singleSymbol" symbollevels="0" enableorderby="0" forceraster="0">
        <symbols>
          <symbol type="line" name="0" alpha="1" clip_to_extent="1" force_rhr="0">
            <layer class="SimpleLine" enabled="1" locked="0" pass="0">
              <Option type="Map">
                <Option name="line_color" type="QString" value="255,127,14,255"/>
                <Option name="line_style" type="QString" value="solid"/>
                <Option name="line_width" type="QString" value="0.4"/>
                <Option name="line_width_unit" type="QString" value="MM"/>
                <Option name="capstyle" type="QString" value="round"/>
                <Option name="joinstyle" type="QString" value="round"/>
              </Option>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- ===== area_transportasi (MultiPolygon) ===== -->
    <maplayer type="vector" geometry="Polygon" wkbType="MultiPolygon" autoRefreshEnabled="0" readOnly="0" refreshOnNotifyEnabled="0" minScale="100000000" maxScale="0" hasScaleBasedVisibilityFlag="0">
      <id>area_transportasi_layer</id>
      <datasource>dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_area' srid=4326 type=MultiPolygon checkPrimaryKeyUnicity='1' table="public"."area_transportasi" (geom)</datasource>
      <layername>area_transportasi</layername>
