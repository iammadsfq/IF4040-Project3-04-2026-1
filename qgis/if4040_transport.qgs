    <!-- ===== provinsi (MultiPolygon) ===== -->
    <maplayer type="vector" geometry="Polygon" wkbType="MultiPolygon" autoRefreshEnabled="0" readOnly="0" refreshOnNotifyEnabled="0" minScale="100000000" maxScale="0" hasScaleBasedVisibilityFlag="0">
      <id>provinsi_layer</id>
      <datasource>dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_provinsi' srid=4326 type=MultiPolygon checkPrimaryKeyUnicity='1' table="public"."provinsi" (geom)</datasource>
      <layername>provinsi</layername>
      <srs>
        <spatialrefsys>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
