<!DOCTYPE qgis PUBLIC 'http://mrcc.com/qgis.dtd' 'SYSTEM'>
<qgis projectname="IF4040 Transportasi Indonesia" version="3.34.0-Prizren">
  <title>IF4040 Transportasi Indonesia</title>

  <projectCrs>
    <spatialrefsys>
      <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
      <srsid>3452</srsid>
      <srid>4326</srid>
      <authid>EPSG:4326</authid>
      <description>WGS 84</description>
      <projectionacronym>longlat</projectionacronym>
      <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
      <geographicflag>true</geographicflag>
    </spatialrefsys>
  </projectCrs>

  <layer-tree-group>
    <customproperties/>
    <layer-tree-layer id="titik_transportasi_layer" name="titik_transportasi" providerKey="postgres" checked="Qt::Checked" expanded="1"
      source="dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_titik' srid=4326 type=Point checkPrimaryKeyUnicity='1' table=&quot;public&quot;.&quot;titik_transportasi&quot; (geom)">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="jalur_transportasi_layer" name="jalur_transportasi" providerKey="postgres" checked="Qt::Checked" expanded="1"
      source="dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_jalur' srid=4326 type=MultiLineString checkPrimaryKeyUnicity='1' table=&quot;public&quot;.&quot;jalur_transportasi&quot; (geom)">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="area_transportasi_layer" name="area_transportasi" providerKey="postgres" checked="Qt::Checked" expanded="1"
      source="dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_area' srid=4326 type=MultiPolygon checkPrimaryKeyUnicity='1' table=&quot;public&quot;.&quot;area_transportasi&quot; (geom)">
      <customproperties/>
    </layer-tree-layer>
    <layer-tree-layer id="provinsi_layer" name="provinsi" providerKey="postgres" checked="Qt::Checked" expanded="1"
      source="dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_provinsi' srid=4326 type=MultiPolygon checkPrimaryKeyUnicity='1' table=&quot;public&quot;.&quot;provinsi&quot; (geom)">
      <customproperties/>
    </layer-tree-layer>
  </layer-tree-group>

  <mapcanvas name="theMapCanvas" annotationsVisible="1">
    <units>degrees</units>
    <extent>
      <xmin>94.5</xmin>
      <ymin>-11.5</ymin>
      <xmax>141.5</xmax>
      <ymax>6.5</ymax>
    </extent>
    <rotation>0</rotation>
    <destinationsrs>
      <spatialrefsys>
        <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
        <srsid>3452</srsid>
        <srid>4326</srid>
        <authid>EPSG:4326</authid>
        <description>WGS 84</description>
        <projectionacronym>longlat</projectionacronym>
        <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
        <geographicflag>true</geographicflag>
      </spatialrefsys>
    </destinationsrs>
    <rendermaptile>0</rendermaptile>
  </mapcanvas>

  <projectlayers>
    <!-- ===== titik_transportasi (Point) ===== -->
    <maplayer type="vector" geometry="Point" wkbType="Point" autoRefreshEnabled="0" readOnly="0" refreshOnNotifyEnabled="0" minScale="100000000" maxScale="0" hasScaleBasedVisibilityFlag="0">
      <id>titik_transportasi_layer</id>
      <datasource>dbname='if4040_transport' host=localhost port=5433 user='postgres' password='postgres' sslmode=disable key='id_titik' srid=4326 type=Point checkPrimaryKeyUnicity='1' table="public"."titik_transportasi" (geom)</datasource>
      <layername>titik_transportasi</layername>
      <srs>
        <spatialrefsys>
          <proj4>+proj=longlat +datum=WGS84 +no_defs</proj4>
          <srsid>3452</srsid>
          <srid>4326</srid>
          <authid>EPSG:4326</authid>
          <description>WGS 84</description>
          <projectionacronym>longlat</projectionacronym>
          <ellipsoidacronym>EPSG:7030</ellipsoidacronym>
          <geographicflag>true</geographicflag>
        </spatialrefsys>
      </srs>
      <provider encoding="">postgres</provider>
      <renderer-v2 type="singleSymbol" symbollevels="0" enableorderby="0" forceraster="0">
        <symbols>
          <symbol type="marker" name="0" alpha="1" clip_to_extent="1" force_rhr="0">
            <layer class="SimpleMarker" enabled="1" locked="0" pass="0">
              <Option type="Map">
                <Option name="name" type="QString" value="circle"/>
                <Option name="color" type="QString" value="214,39,40,255"/>
                <Option name="size" type="QString" value="2"/>
                <Option name="size_unit" type="QString" value="MM"/>
                <Option name="outline_color" type="QString" value="255,255,255,255"/>
                <Option name="outline_style" type="QString" value="solid"/>
                <Option name="outline_width" type="QString" value="0.2"/>
                <Option name="outline_width_unit" type="QString" value="MM"/>
              </Option>
            </layer>
          </symbol>
        </symbols>
      </renderer-v2>
    </maplayer>

    <!-- ===== jalur_transportasi (MultiLineString) ===== -->
    <maplayer type="vector" geometry="Line" wkbType="MultiLineString" autoRefreshEnabled="0" readOnly="0" refreshOnNotifyEnabled="0" minScale="100000000" maxScale="0" hasScaleBasedVisibilityFlag="0">
